# CVGen — Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is in .gitignore — never commit real keys.

# Supabase (find these in your Supabase project settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Anthropic API key
# ⚠️  This is used ONLY in the Supabase Edge Function — never in src/
# Set this via: npx supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# Do NOT put it here for local frontend dev — it would be exposed in the browser.
# ANTHROPIC_API_KEY=sk-ant-your-key-here
